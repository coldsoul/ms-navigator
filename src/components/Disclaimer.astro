---
// src/components/Disclaimer.astro
interface Props {
  lang?: string;
}
const { lang = 'bg' } = Astro.props;
---
<div class="bg-ms-disclaimer-bg border border-ms-disclaimer-border rounded-lg px-[1.1rem] py-[0.85rem] text-[0.88rem] text-ms-disclaimer-text leading-[1.5]">
  {lang === 'en' ? (
    <><strong class="font-semibold">Important:</strong> This site provides information, not medical advice. Always consult your doctor for treatment decisions.</>
  ) : (
    <><strong class="font-semibold">Важно:</strong> Този сайт предоставя информация, не медицински съвет. Винаги се консултирай с лекаря си за решения относно лечението.</>
  )}
</div>
