---
// src/pages/chesti-vaprosi.astro
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from '../components/SectionLayout.astro';

const entry = await getEntry('sections', 'chesti-vaprosi');
if (!entry) throw new Error('Section not found: chesti-vaprosi');
const { Content } = await render(entry);

// Mirrors the Q&A content in src/content/sections/chesti-vaprosi.md
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Мога ли да работя?",
      "acceptedAnswer": { "@type": "Answer", "text": "Да. Много хора с МС продължават да работят години и десетилетия след диагнозата. Зависи от вида работа и от симптомите ти. Някои хора продължават без промяна, други адаптират графика си или преминават на по-лека позиция." }
    },
    {
      "@type": "Question",
      "name": "Мога ли да имам деца?",
      "acceptedAnswer": { "@type": "Answer", "text": "Да. МС не е пречка да бъдеш родител. Много жени с МС раждат здрави деца. По време на бременността дори е възможно жената да се чувства по-добре — при много жени пристъпите намаляват. И при двата случая е важно да планирате с невролога си, защото някои лекарства трябва да бъдат спрени или сменени преди зачеване." }
    },
    {
      "@type": "Question",
      "name": "Ще бъда ли в инвалидна количка?",
      "acceptedAnswer": { "@type": "Answer", "text": "Не непременно. Това е може би най-големият страх след диагнозата и отговорът е — при повечето хора не. Болестта протича различно при всеки. Много хора живеят десетилетия без значителни физически ограничения. Съвременните терапии значително подобряват дългосрочната прогноза." }
    },
    {
      "@type": "Question",
      "name": "Наследствена ли е МС?",
      "acceptedAnswer": { "@type": "Answer", "text": "Не в класическия смисъл. Няма ген, який да предава МС от родител на дете. Генетиката играе малка роля в риска, но шансът детето ти да развие МС е много нисък. Огромното мнозинство деца на родители с МС никога не развиват болестта." }
    },
    {
      "@type": "Question",
      "name": "Мога ли да спортувам?",
      "acceptedAnswer": { "@type": "Answer", "text": "Да, и дори е препоръчително. Физическата активност помага при умора, настроение, равновесие и обща физическа форма. Плуването е особено подходящо, защото водата държи тялото хладно. Избягвай прекалено натоварване и прегряване — слушай тялото си." }
    },
    {
      "@type": "Question",
      "name": "Мога ли да пия алкохол?",
      "acceptedAnswer": { "@type": "Answer", "text": "В умерени количества — обикновено да, но имай предвид, че алкохолът може да засили някои симптоми — особено проблеми с равновесието, координацията и мозъчната мъгла. Освен това някои лекарства не се комбинират добре с алкохол. Попитай невролога си дали твоята конкретна терапия позволява умерена консумация." }
    },
    {
      "@type": "Question",
      "name": "Мога ли да карам кола?",
      "acceptedAnswer": { "@type": "Answer", "text": "В повечето случаи — да. МС сама по себе си не е автоматична причина да спреш да караш. Но ако имаш симптоми, които засягат зрението, реакциите или координацията — бъди честен със себе си. Говори с лекаря си, ако имаш съмнения." }
    },
    {
      "@type": "Question",
      "name": "Ще се промени ли продължителността на живота ми?",
      "acceptedAnswer": { "@type": "Answer", "text": "Хората с МС живеят дълго. Изследванията показват, че продължителността на живота при МС е само малко по-кратка от средната — и тази разлика продължава да намалява с подобряването на терапиите. МС не е терминална болест." }
    },
    {
      "@type": "Question",
      "name": "Мога ли да пуша?",
      "acceptedAnswer": { "@type": "Answer", "text": "Науката е почти единодушна: пушенето е изключително вредно при МС. Изследванията показват, че пушенето ускорява прогресията на болестта, намалява ефективността на терапиите и увеличава риска от нови лезии." }
    },
    {
      "@type": "Question",
      "name": "Мога ли да ям млечни продукти?",
      "acceptedAnswer": { "@type": "Answer", "text": "Към момента няма категорични научни доказателства, че млечните продукти влошават МС. Но всеки организъм е различен. Ако забелязваш, че се чувстваш по-зле, когато ядеш млечно — слушай тялото си и намали или спри." }
    },
    {
      "@type": "Question",
      "name": "Трябва ли да променя живота си изцяло?",
      "acceptedAnswer": { "@type": "Answer", "text": "Не. Диагнозата не означава, че трябва да спреш да бъдеш себе си. Ще се наложат някои адаптации — може би повече почивка, по-внимателно хранене, редовни прегледи. Но ти си същият човек. МС е нещо, което имаш — не нещо, което си." }
    },
  ],
});
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <SectionLayout title={entry.data.title} summary={entry.data.summary}>
    <Content />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </SectionLayout>
</BaseLayout>
