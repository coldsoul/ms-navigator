---
// src/pages/en/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionCard from '../../components/SectionCard.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';

const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "MS Navigator",
  "url": "https://ms-navigator.bg/en/",
  "description": "Information about multiple sclerosis in plain English. Created by a person with MS, for people with MS.",
  "inLanguage": "en",
});

const sections = [
  { icon: "🧠", title: "What is Multiple Sclerosis?",  description: "What happens in your body, explained in plain words.",                 href: "/en/what-is-ms" },
  { icon: "📋", title: "Types of MS",                  description: "Relapsing-remitting, progressive — what they mean for you.",           href: "/en/types-of-ms" },
  { icon: "⚡", title: "What is a Relapse?",            description: "How to recognise a relapse and what to do.",                          href: "/en/relapse" },
  { icon: "🔍", title: "Symptoms",                     description: "What you might experience and why it's different for everyone.",       href: "/en/symptoms" },
  { icon: "🏥", title: "Tests and Investigations",     description: "MRI, lumbar puncture — what the results mean.",                       href: "/en/tests" },
  { icon: "💊", title: "Treatment",                    description: "What therapies exist today, including HSCT.",                         href: "/en/treatment" },
  { icon: "👨‍⚕️", title: "Your Medical Team",         description: "How to work effectively with your doctors.",                          href: "/en/medical-team" },
  { icon: "🥗", title: "Diet and Nutrition",           description: "What science knows and what's just fashion.",                         href: "/en/diet-and-nutrition" },
  { icon: "🚩", title: "Watch Out: Scams",             description: "How to recognise fake \"cures\" and fraud.",                          href: "/en/scams" },
  { icon: "💛", title: "The Emotional Side",           description: "On grief, fear, and how to cope.",                                    href: "/en/emotions" },
  { icon: "❓", title: "Frequently Asked Questions",   description: "Work, children, sport — quick answers.",                              href: "/en/faq" },
];
---
<BaseLayout
  title="MS Navigator"
  description="Information about multiple sclerosis in plain English. Created by a person with MS, for people with MS."
  lang="en"
>
  <header slot="header" class="max-w-content mx-auto px-6 pt-10">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 font-heading font-bold text-[1.75rem] tracking-[-0.02em] text-ms-accent">
        <span class="w-[10px] h-[10px] rounded-full bg-ms-accent opacity-50 inline-block" aria-hidden="true"></span>
        MS Navigator
      </div>
      <LanguageSwitcher />
    </div>
  </header>

  <section class="max-w-content mx-auto px-6 pt-8 pb-4" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="font-heading font-bold text-[clamp(1.6rem,4vw,2.2rem)] leading-[1.3] tracking-[-0.01em] text-ms-text mb-3">
      Information about multiple sclerosis in plain English
    </h1>
    <p class="text-[1.1rem] text-ms-muted max-w-[600px] leading-[1.65]">
      Created by a person with MS, for people with MS. Clear and honest answers — no medical jargon, no unnecessary panic.
    </p>
  </section>

  <div class="max-w-content mx-auto px-6 mt-2 mb-0">
    <Disclaimer lang="en" />
  </div>

  <section class="max-w-content mx-auto px-6 pt-7 pb-12" aria-label="Sections">
    <div class="grid grid-cols-1 gap-[0.85rem] sm-ms:grid-cols-2">
      {sections.map((s, i) => (
        <SectionCard
          title={s.title}
          description={s.description}
          icon={s.icon}
          href={s.href}
          animationDelay={`${(i + 1) * 0.03}s`}
        />
      ))}
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={websiteSchema} />

  <footer slot="footer" class="max-w-content mx-auto px-6 py-6 border-t border-ms-border text-[0.85rem] text-ms-muted text-center leading-[1.6]">
    MS Navigator &middot; Made with care by a person with MS &middot; Not a substitute for medical advice &middot; <a href="/en/about" class="underline hover:text-ms-accent transition-colors">About</a>
  </footer>
</BaseLayout>
