---
// src/pages/en/[slug].astro
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLayout from '../../components/SectionLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('sections', ({ id }) => id.startsWith('en/'));
  return entries.map((entry: CollectionEntry<'sections'>) => ({
    params: { slug: entry.id.replace('en/', '').replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'sections'> };
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary} lang="en">
  <SectionLayout title={entry.data.title} summary={entry.data.summary} lang="en">
    <Content />
  </SectionLayout>
</BaseLayout>
